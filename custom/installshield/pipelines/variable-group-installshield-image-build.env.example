# Copy to Azure DevOps → Pipelines → Library → Variable group: installshield-image-build
#
# Link this group to pipeline: custom/installshield/pipelines/build-image-ned-prd.yml

# --- Azure ---
SUBSCRIPTION_ID=426ea593-fd6e-40a0-a314-be2b3d6a2a06
AZURE_LOCATION=germanywestcentral
IMAGE_BUILD_RG_NAME=rg-ned-prd-mdp-001
GALLERY_NAME=acg_ned_prd_mdp_001
GALLERY_RG_NAME=rg-ned-prd-mdp-001
MDP_RG_NAME=rg-ned-prd-mdp-001
MDP_POOL_NAME=mdp-ned-prd-winbuild-001

# --- InstallShield SAB installer (storage account with container installshield-artifacts) ---
INSTALLSHIELD_ARTIFACTS_STORAGE_ACCOUNT=<your-storage-account-name>

# --- Secrets (mark as secret in ADO UI) ---
# INSTALLSHIELD_INSTALLER_SAS_URL=https://...?sv=...   # optional if using blob + MI on build agent

# --- Pipeline service connection name (used as $(azureServiceConnection) in YAML) ---
# Create ARM service connection with Contributor on rg-ned-prd-mdp-001, then set in pipeline UI
# or add as variable: azureServiceConnection = <connection-name>
